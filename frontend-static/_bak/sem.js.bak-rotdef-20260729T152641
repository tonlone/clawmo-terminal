        <td class="num">${g.iv_rank == null ? '—' : Number(g.iv_rank).toFixed(0)}</td>
        <td class="num">${g.gamma_flip == null ? '—' : Number(g.gamma_flip).toFixed(2)}</td></tr>`).join('');
    }
    return `<div class="mod-panel"><div class="mod-panel-title">OPTIONS &amp; POSITIONING
        <span class="mod-panel-sub">${sub}</span></div>
      <div class="acct-strip" style="grid-template-columns:repeat(4,1fr)">${cards}</div>
      <div class="tbl-wrap" style="padding:6px 10px"><table class="tbl-dense"><thead><tr>
        ${semThL('TICKER','pos')}${semTh('NET GEX $BN','pos')}${semTh('REGIME','pos')}
        ${semTh('P/C OI','pos')}${semTh('IV RANK','pos')}${semTh('GAMMA FLIP','pos')}
      </tr></thead><tbody>${rows || '<tr><td colspan="6" class="empty">no coverage</td></tr>'}</tbody></table></div>
      ${SEM_GUIDES.pos()}
      ${semCaveats({
        not_a_signal:'None of this is a signal, and none of it measures the intraday "large short flow" that circulating posts claim to detect — no public data source does.',
        why_separate:'These three feeds measure different things on different clocks and will often disagree. That disagreement is the point, and is why they are not blended into a single gauge.',
        putcall_scope:'CBOE put/call is MARKET-WIDE, not semis-specific — backdrop, not a read on these stocks.',
        cot_lag:'CFTC COT is a Tuesday snapshot published on Friday, so it is several days stale; its z is fitted on a rolling 52-week window.',
        gex_basis:'Dealer GEX is an end-of-day ESTIMATE derived from open interest — not observed order flow.'
      }, ['not_a_signal','why_separate','putcall_scope','cot_lag','gex_basis'])}</div>`;
