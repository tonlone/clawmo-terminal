  // ── P-D ATR ladder (twin of semiconductor.html) ─────────────────────────────────────────────
  // Every RQ6 + review mitigation is structural: bands not lines · ATR axis with price hover-only
  // · UNTESTED disclosure ABOVE the svg · kind carries a LETTER GLYPH as well as hue · one
  // sub-lane per kind so overlaps cannot merge · constant alpha · chevrons for zones clipped by
  // the frame · dist_atr taken FROM the JSON, never recomputed.
  // Reworked 2026-07-28 after the comprehension review: glyphs DELETED (a third redundant decode
  // step), names in plain language, rows anchored to a real price, axis in days not ATR.
  const KL_KIND = {
    swing:  { color:'#3987e5', name:'past swing area' },
    volume: { color:'#d95926', name:'heaviest-traded price' },
    vwap:   { color:'#199e70', name:'average traded price' },
    range:  { color:'#c98500', name:'52-week extreme' }
  };
  const KL_TICK = {'-2':'2 days below','-1':'1 day below','0':'today','1':'1 day above','2':'2 days above'};
  const KL_ORDER = ['swing','volume','vwap','range'];

  function semLadderPanel(d) {
    if (!d || !d.tickers) return '';
    const tickers = Object.keys(d.tickers);
    if (!tickers.length) return '';
    const MAXA = d.params.max_atr_away, W = 900, PADL = 118, PADR = 48, ROW = 28, TOP = 32;
    const H = TOP + tickers.length * ROW + 24;
    const x = a => PADL + ((a + MAXA) / (2 * MAXA)) * (W - PADL - PADR);
    const laneH = 4, laneGap = 1;
    const out = [`<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" role="img"
                   aria-label="Key level zones by distance in ATR">`];
    [-2,-1,0,1,2].forEach(a => {
      const z = a === 0;
      out.push(`<line x1="${x(a).toFixed(1)}" y1="${TOP-10}" x2="${x(a).toFixed(1)}" y2="${H-20}"
        stroke="${z ? 'rgba(220,220,230,0.7)' : 'rgba(139,148,158,0.16)'}" stroke-width="${z?2:1}"/>`);
      out.push(`<text x="${x(a).toFixed(1)}" y="${H-6}" text-anchor="middle" font-size="9"
        fill="${z?'var(--fg-dim)':'var(--fg-faint)'}"${z?' font-weight="700"':''}>${KL_TICK[String(a)]}</text>`);
    });
    out.push(`<text x="${W-PADR}" y="${TOP-18}" text-anchor="end" font-size="9"
      fill="var(--fg-faint)">prices as of ${semEsc(d.as_of)}</text>`);
    tickers.forEach((t, ri) => {
      const row = d.tickers[t], yTop = TOP + ri * ROW;
      out.push(`<text x="6" y="${yTop+ROW/2+3}" font-size="10" font-weight="700"
        fill="var(--accent)">${semEsc(t)}</text>`);
      out.push(`<text x="${PADL-8}" y="${yTop+ROW/2+3}" text-anchor="end" font-size="9.5"
        fill="var(--fg-dim)">$${row.spot.toFixed(2)}</text>`);
      if (!row.levels.length) {
        out.push(`<text x="${x(0)}" y="${yTop+ROW/2+3}" font-size="9" fill="var(--fg-faint)"
          text-anchor="middle">no past price area within two days' move</text>`); return;
      }
      KL_ORDER.forEach((kind, li) => {
        row.levels.filter(l => l.kind === kind).forEach(l => {
          const k = KL_KIND[kind] || KL_KIND.swing;
          const lo = (l.zone_low - row.spot) / row.atr14, hi = (l.zone_high - row.spot) / row.atr14;
          const xl = x(Math.max(lo, -MAXA)), xr = x(Math.min(hi, MAXA));
          const y = yTop + 4 + li * (laneH + laneGap);
          const tip = `${t} · ${l.label} · $${l.zone_low}–$${l.zone_high} · ${Math.abs(l.dist_atr).toFixed(1)} days' move ${l.side} · ${l.derivation}`;
          out.push(`<g><title>${semEsc(tip)}</title>
            <rect x="${xl.toFixed(1)}" y="${y}" width="${Math.max(2,xr-xl).toFixed(1)}"
              height="${laneH}" fill="${k.color}" opacity="0.42"/>
            ${lo < -MAXA ? `<text x="${PADL-2}" y="${y+laneH}" font-size="8" fill="${k.color}" text-anchor="end">◂</text>` : ''}
            ${hi >  MAXA ? `<text x="${W-PADR+2}" y="${y+laneH}" font-size="8" fill="${k.color}">▸</text>` : ''}
          </g>`);
        });
      });
    });
    out.push('</svg>');
    const legend = KL_ORDER.map(k => {
      const m = KL_KIND[k];
      return `<span style="display:inline-flex;align-items:center;gap:4px;margin-right:12px">
        <span style="display:inline-block;width:16px;height:5px;background:${m.color};opacity:0.42"></span>
        <span style="color:var(--fg-dim);font-size:10px">${m.name}</span></span>`;
    }).join('');
    const eg = (() => {
      const first = tickers[0], fr = d.tickers[first];
      if (!fr || !fr.levels.length) return '';
      const l0 = fr.levels[0];
      return `<b>Reading one row:</b> ${semEsc(first)} is trading at <b>$${fr.spot.toFixed(2)}</b>.
        Its ${semEsc((KL_KIND[l0.kind]||{}).name || l0.label)} sits at
        <b>$${l0.zone_low}–$${l0.zone_high}</b>, about
        <b>${Math.abs(l0.dist_atr).toFixed(1)} of a typical day's move ${semEsc(l0.side)}</b>
        where it trades now.`;
    })();
    return `<div class="mod-panel"><div class="mod-panel-title">PAST PRICE AREAS
        <span class="mod-panel-sub">distance from today, in typical daily moves · ${semEsc(d.as_of)}</span></div>
      <div class="sem-whatis" style="border-left-color:#f59e0b;background:rgba(245,158,11,0.10)">
        <b>⚠ ${semEsc((d.disclosures||{}).untested || '')}</b></div>
      <div style="padding:4px 10px;overflow-x:auto">${out.join('')}</div>
      <div style="padding:0 10px 6px">${legend}</div>
      <div class="chart-legend"><span class="chart-note" style="display:block">
        <b>Each row is one stock.</b> The thick line down the middle is where it trades today; the
        coloured bands are <b>price areas from its own past</b>, placed by how far they sit from
        today — measured in that stock's own typical daily move, so the scale means the same thing
        for a $1,000 stock and a $30 one.<br><br>${eg}<br><br>
        <span style="color:var(--fg-faint)">A blank row means nothing within two days' move — not
        that the stock has no history. ◂▸ marks a band continuing past the edge. Hover any band, or
        read exact prices in the table below.</span>
      </span></div></div>`;
  }

