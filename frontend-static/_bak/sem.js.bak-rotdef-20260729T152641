  // ── P-C.1 + P-C.3 (twins of semiconductor.html) ─────────────────────────────────────────────
  // ⚠ OC_CHART.rankBars is NOT used for the GEX bar: it grows every bar rightward from a left
  // edge and encodes sign by COLOUR ALONE. The review requires sign to ride on bar DIRECTION
  // (primary channel) with colour as redundant reinforcement, so this is a hand-rolled diverging
  // bar about a centre zero line — same semantics as the web surface.
  function semCotPanel(cot) {
    if (!cot || !cot.instruments) return '';
    const want = cot.instruments.filter(i => /Nasdaq 100|S&P 500/i.test(i.name));
    if (!want.length) return '';
    const charts = want.map(inst => {
      const h = inst.history || {};
      const v = h.netSpec || [], dts = h.dates || [];
      if (v.length < 4) return '';
      const mean = v.reduce((a, b) => a + b, 0) / v.length;
      const sd = Math.sqrt(v.reduce((a, b) => a + (b - mean) * (b - mean), 0) / v.length);
      // STATIC full-window band — a rolling band would silently diverge from the published z,
      // which is defined on exactly these points. Neutral grey only: no semantic colour.
      const hi = mean + 2 * sd, lo = mean - 2 * sd;
      const svg = OC_CHART.lineAbs([
        { name: 'upper', values: dts.map(() => hi), color: 'rgba(154,164,173,0.55)', dashed: true },
        { name: 'lower', values: dts.map(() => lo), color: 'rgba(154,164,173,0.55)', dashed: true },
        { name: inst.name, values: v, color: '#3987e5' },
      ], { w: 430, h: 150, padL: 44, padB: 20, gridY: 3,
           yFmt: x => (x / 1000).toFixed(0) + 'k',
           xLabels: dts.map(d => d.slice(5)) });
      return `<div style="flex:1;min-width:0">
        <div class="mod-panel-sub small" style="padding:0 0 2px 6px">${semEsc(inst.name)} · spec z ${inst.zScoreSpec}</div>
        ${svg}</div>`;
    }).join('');
    const asOf = want[0].asOf;
    return `<div class="mod-panel"><div class="mod-panel-title">FUTURES POSITIONING
        <span class="mod-panel-sub">speculative net position · trailing 52 weeks · as of ${semEsc(asOf)}</span></div>
      <div style="display:flex;gap:10px;padding:6px 10px">${charts}</div>
      <div class="chart-legend"><span class="chart-note" style="display:block">
        <b>Who is betting which way in the futures market.</b> The blue line is how many contracts
        speculative traders hold net long (above zero) or net short (below). The grey band is the
        <b>trailing 52-week ±2σ reference — not a fair-value range and not a forecast</b>.
        <b>Roughly 1 week in 20 sits outside such a band even when nothing unusual is happening</b>,
        so an excursion is a prompt to look, not a signal. Positioning is a Tuesday snapshot
        published the following Friday, so it is several days old.
      </span></div></div>`;
  }

  function semGexBarPanel(gex) {
    if (!gex || !gex.stocks) return '';
    const W = ['NVDA','AMD','AVGO','MU','WDC','STX','SNDK','INTC','QCOM','TXN',
               'LRCX','AMAT','KLAC','ADI','MCHP','ON','NXPI','MRVL'];
    const by = {}; gex.stocks.forEach(x => { by[x.ticker] = x; });
    const rows = W.map(t => by[t]).filter(Boolean)
                  .sort((a, b) => (a.net_gex_bn || 0) - (b.net_gex_bn || 0));
    if (!rows.length) return '';
    const maxMag = Math.max(...rows.map(r => Math.abs(r.net_gex_bn || 0)), 0.001);
    const CW = 880, LAB = 62, ROW = 17, MID = LAB + (CW - LAB - 20) / 2, HALF = (CW - LAB - 20) / 2;
    const H = rows.length * ROW + 26;
    const bars = rows.map((r, i) => {
      const v = r.net_gex_bn || 0, y = 8 + i * ROW;
      const w = (Math.abs(v) / maxMag) * HALF * 0.94;
      const x = v < 0 ? MID - w : MID;
      const col = v < 0 ? '#d95926' : '#199e70';
      return `<g><title>${semEsc(r.ticker)} · ${v < 0 ? 'amplifying' : 'damping'} · ${v.toFixed(3)} $bn · ${semEsc(r.regime || '')}</title>
        <text x="${LAB - 6}" y="${y + 9}" text-anchor="end" font-size="9.5" class="tk"
          fill="var(--accent)">${semEsc(r.ticker)}</text>
        <rect x="${x.toFixed(1)}" y="${y + 2}" width="${Math.max(1.5, w).toFixed(1)}" height="${ROW - 6}"
          fill="${col}" opacity="0.8"/></g>`;
    }).join('');
    const neg = rows.filter(r => r.net_gex_bn < 0).length;
    return `<div class="mod-panel"><div class="mod-panel-title">DEALER GAMMA BY NAME
        <span class="mod-panel-sub">left of centre = amplifying moves · as of ${semEsc(gex.updated || '—')}</span></div>
      <div style="padding:6px 10px;overflow-x:auto"><svg viewBox="0 0 ${CW} ${H}" width="100%" height="${H}"
        role="img" aria-label="Dealer net gamma by name">
        <line x1="${MID}" y1="2" x2="${MID}" y2="${H - 18}" stroke="rgba(220,220,230,0.6)" stroke-width="2"/>
        ${bars}
        <text x="${MID - HALF / 2}" y="${H - 5}" text-anchor="middle" font-size="9"
          fill="var(--fg-faint)">amplifying</text>
        <text x="${MID + HALF / 2}" y="${H - 5}" text-anchor="middle" font-size="9"
          fill="var(--fg-faint)">damping</text>
      </svg></div>
      <div class="chart-legend"><span class="chart-note" style="display:block">
        <b>How option dealers must trade to stay hedged.</b> Bars <b>left of the centre line</b>
        mean dealers have to sell as prices fall and buy as they rise — that <b>amplifies</b>
        whatever the market is already doing, and is why some days feel unusually violent. Bars to
        the right mean the opposite: dealers lean against moves and <b>damp</b> them. Today
        <b>${neg} of ${rows.length}</b> watchlist names sit on the amplifying side.
        Direction is shown by which side of the centre a bar falls on; the colour only repeats it.
        This is an end-of-day estimate built from options open interest — not observed trading, and
        not a signal.
      </span></div></div>`;
  }

