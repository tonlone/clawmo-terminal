  const PA_COLORS = { semis: '#3987e5', storage: '#d95926', hardware: '#199e70', mag7: '#c98500' };
  const PA_ORDER = ['semis', 'storage', 'hardware', 'mag7'];

  function semRelPerfPanel(d) {
    if (!d || !d.baskets || !window.OC_CHART) return '';
    const ref = d.baskets[PA_ORDER[0]] && d.baskets[PA_ORDER[0]].rs_line;
    if (!ref || !ref.dates || ref.dates.length < 2) return '';
    const series = PA_ORDER.map(k => {
      const b = d.baskets[k]; if (!b || !b.rs_line) return null;
      const rl = b.rs_line, bc = rl.basket_cum_pct, bm = rl.spy_cum_pct;
      // No rebasing here (unlike the web twin) — values are plotted absolute, so the endpoint has
      // always equalled spreads.spy.63d. What was WRONG was the caption: it claimed every line
      // starts at 0, which was false without an anchor (first points were −2.50 / −3.39 / …).
      // 2026-07-29: compute_sector_rs.py emits a leading anchor bar pinned to 0.0, so the claim is
      // now true here by construction. ⛔ Do not add a rebase to "match" the web twin — that is
      // exactly what made the web chart drop a session and disagree with the table by up to 4.29pp.
      // Guard: a basket whose membership completed mid-window starts THERE, never zero-filled.
      let startIdx = rl.dates.findIndex(dt => !b.members_complete_from || dt >= b.members_complete_from);
      if (startIdx < 0) startIdx = 0;
      const values = rl.dates.map((dt, i) =>
        (i < startIdx || bc[i] == null || bm[i] == null)
          ? null : ((1 + bc[i] / 100) / (1 + bm[i] / 100) - 1) * 100);
      return { name: SEM_LABEL[k] || k, values, color: PA_COLORS[k], dashed: k === 'mag7' };
    }).filter(Boolean);
    if (!series.length) return '';

    const svg = OC_CHART.lineAbs(series, {
      w: 900, h: 200, padL: 46, padB: 24, gridY: 4,
      yFmt: v => (v > 0 ? '+' : '') + v.toFixed(0) + '%',
      xLabels: ref.dates.map(dt => dt.slice(5)),
    });
    // dataviz: identity is never colour-alone — legend always present for >=2 series.
    const legend = series.map(s =>
      `<span style="display:inline-flex;align-items:center;gap:4px;margin-right:12px">
