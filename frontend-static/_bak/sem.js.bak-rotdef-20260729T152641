    const legend = series.map(x =>
      `<span style="display:inline-flex;align-items:center;gap:4px;margin-right:12px">
         <span style="width:12px;height:0;border-top:${x.dashed ? '2px dashed' : '2px solid'} ${x.color};
                      display:inline-block"></span>
         <span style="color:var(--fg-dim);font-size:10px">${semEsc(x.name)}</span></span>`).join('');
    const st = d.staleness || {};
    return `<div class="mod-panel"><div class="mod-panel-title">SHORT INTEREST vs THE MARKET
        <span class="mod-panel-sub">% of shares sold short, every settlement since ${semEsc(axis[0])}</span></div>
      <div style="padding:6px 10px">${svg}</div>
      <div style="padding:0 10px 6px">${legend}</div>
      <div class="chart-legend"><span class="chart-note" style="display:block">
        How heavily each group is <b>sold short</b>, as a share of all its shares. The
        <b>dashed grey line is the whole market</b> — above it a group is more heavily shorted than
